{
  "expo": {
    "name": "PassPath",
    "slug": "passpath",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "passpath",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#1d4ed8"
    },
    "ios": { "supportsTablet": true },
    "android": {
      "adaptiveIcon": { "backgroundColor": "#1d4ed8" }
    },
    "web": { "bundler": "metro", "output": "static" },
    "plugins": ["expo-router"],
    "extra": {
      "_comment_apiBaseUrl": "For Expo Go on physical device, use your machine's LAN IP (e.g., 192.168.1.10), NOT localhost",
      "apiBaseUrl": "http://localhost:3000/api",

      "_comment_eas": "EAS Project ID for Expo Application Services (builds, updates, etc.)",
      "eas": {
        "projectId": "your-eas-project-id"
      }
    }
  }
}
